# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
venv/
.venv/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*.bak

# OS
.DS_Store
Thumbs.db

# Flask
instance/
*.log

# Generated image cache (regenerável)
cache/

# Disposable tree used by the test suite (tests/conftest.py)
.pytest_sandbox/

# Dashboard data (keep structure, ignore content)
dashboard/data/*.json
dashboard/static/images/*.png
!dashboard/static/images/pin-*.png
dashboard/data/dashboard.db
dashboard/data/.env
dashboard/data/flask_secret_key

# Prevent credential leaks
test_upload.py
.well-known/
dashboard/data/*.md
dashboard/data/*.txt
scripts/*.bak.php

# Server-side material must never be deployed with the app: wp-config backups
# carry DB credentials and htaccess dumps expose the host layout.
scripts/_archive/
scripts/_backup*
scripts/_probe*
scripts/*.bak
scripts/*.backup
scripts/*.bak2

# Generated by the Google Search Console helper
sitemap_static.xml
template_audit.json
google_urls.txt
new_site_urls.txt
*.png
!dashboard/static/icon*.png
!dashboard/static/images/pin-*.png
board.html
