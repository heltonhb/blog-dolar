# Blog em Dolar — Variáveis de Ambiente
# Copie para .env e preencha com suas credenciais reais.
# NUNCA faça commit do .env com valores reais!

# ─── Dashboard ────────────────────────────────────────────────────
# Senha de acesso ao dashboard (deixe vazio para desativar autenticação)
DASHBOARD_PASSWORD=sua_senha_segura_aqui

# Chave secreta do Flask (gerada automaticamente se omitida)
# FLASK_SECRET_KEY=gere_com_python_-c_"import_secrets;print(secrets.token_hex(32))"

# ─── Gemini AI ────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey (gratuito)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── WordPress REST API ───────────────────────────────────────────
# URL do site WordPress
SITE_URL=https://tech-tips.byethost4.com
# Usuário do WordPress
WP_USER=your_wp_username
# Application Password (WP Admin → Usuários → Perfil → Senhas de Aplicativo)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─── WordPress Database (acesso direto — fallback) ────────────────
WP_DB_HOST=sql310.byetcluster.com
WP_DB_USER=your_db_user
WP_DB_PASS=your_db_password
WP_DB_NAME=your_db_name

# ─── FTP ByetHost ─────────────────────────────────────────────────
FTP_HOST=ftpupload.net
FTP_USER=your_ftp_user
FTP_PASS=your_ftp_password

# ─── AdCash ──────────────────────────────────────────────────────
# Zone ID e token da conta Publisher AdCash
ADCASH_ZONE_ID=your_zone_id
ADCASH_API_TOKEN=your_adcash_api_token

# ─── Pinterest API v5 ─────────────────────────────────────────────
# Gere em: https://developers.pinterest.com/
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token
PINTEREST_BOARD_ID=your_board_id
